---
import { Picture } from "astro:assets";
import cube from "../assets/cube.jpg";
import { site } from "../site";
---

<section class="relative isolate overflow-hidden bg-canvas">
  <div class="photo relative h-44 overflow-hidden bg-black sm:h-56 md:absolute md:inset-0 md:h-auto">
    <Picture
      src={cube}
      formats={["avif", "webp"]}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      alt={site.hero.alt}
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[6%_center]"
    />
    <div class="veil absolute inset-0"></div>
  </div>

  <div
    class="relative mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 md:flex md:min-h-[26rem] md:items-center md:justify-end md:py-16"
  >
    <div class="md:w-[52%]">
      <h1 class="display text-4xl sm:text-5xl">
        {
          site.headline.map((line, i) => (
            <>
              <span class:list={[i === site.headlineAccentIndex && "text-green"]}>
                {line}
              </span>
              {i < site.headline.length - 1 && <br />}
            </>
          ))
        }
      </h1>

      <p class="mt-4 max-w-[46ch] text-sm leading-relaxed text-muted sm:text-base">
        {site.tagline}
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/apps/"
          class="rounded-md bg-purple px-4 py-2 text-sm font-bold text-surface transition-opacity hover:opacity-90"
        >
          Open an app
        </a>
        <a
          href="/projects/"
          class="rounded-md border border-line px-4 py-2 text-sm font-bold text-ink transition-colors hover:border-muted"
        >
          Browse the code
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile: the photo is a band, so it only needs to settle into the page. */
  .veil {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0) 40%,
      var(--color-canvas) 100%
    );
  }

  /* Desktop: the photo sits behind the text, so the gradient has to reach
     full page background before the text column starts. */
  @media (min-width: 768px) {
    .veil {
      background: linear-gradient(
        to right,
        rgba(40, 42, 54, 0) 0%,
        rgba(40, 42, 54, 0.35) 24%,
        rgba(40, 42, 54, 0.92) 42%,
        var(--color-canvas) 52%
      );
    }
    .photo::after {
      content: "";
      position: absolute;
      inset: auto 0 0 0;
      height: 4rem;
      background: linear-gradient(to bottom, transparent, var(--color-canvas));
    }
  }
</style>
