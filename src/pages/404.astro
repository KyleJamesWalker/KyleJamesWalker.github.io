---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="That page does not exist.">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-green">404</p>
    <h1 class="display mt-2 text-4xl sm:text-5xl">This page is not here.</h1>
    <p class="mt-4 max-w-[52ch] text-sm leading-relaxed text-muted sm:text-base">
      The blog that used to live on this site is gone. Everything else moved to
      one of the two places below.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/apps/"
        class="rounded-md bg-purple px-4 py-2 text-sm font-bold text-surface hover:opacity-90"
        >Apps</a
      >
      <a
        href="/projects/"
        class="rounded-md border border-line px-4 py-2 text-sm font-bold text-ink hover:border-muted"
        >Projects</a
      >
    </div>
  </div>
</Base>
