---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const apps = await getCollection("apps");
  return apps.map((app) => ({ params: { slug: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { title, tagline, screenshot, screenshotAlt, source, tags } = app.data;
const { Content } = await render(app);
const runHref = `/apps/${app.id}/run/`;
---

<Base title={title} description={tagline} section="apps">
  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <a href="/apps/" class="text-xs text-cyan hover:text-ink">← All apps</a>

    <header class="mt-4 grid gap-8 lg:grid-cols-2 lg:items-start">
      <div>
        <span class="eyebrow inline-block rounded-xs bg-green px-1.5 py-0.5 text-surface">
          App
        </span>
        <h1 class="display mt-3 text-3xl sm:text-4xl">{title}</h1>
        <p class="mt-3 max-w-[52ch] text-sm leading-relaxed text-muted sm:text-base">
          {tagline}
        </p>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={runHref}
            class="rounded-md bg-purple px-4 py-2 text-sm font-bold text-surface transition-opacity hover:opacity-90"
          >
            Launch app
          </a>
          {
            source && (
              <a
                href={source}
                rel="noopener"
                class="rounded-md border border-line px-4 py-2 text-sm font-bold text-ink transition-colors hover:border-muted"
              >
                Source ↗
              </a>
            )
          }
        </div>

        {
          tags.length > 0 && (
            <ul class="mt-5 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="rounded-xs border border-line px-2 py-0.5 font-mono text-xs text-muted">
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        screenshot && (
          <Image
            src={screenshot}
            alt={screenshotAlt ?? ""}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 50vw, 92vw"
            loading="eager"
            class="w-full rounded-md border border-line"
          />
        )
      }
    </header>

    <div class="prose-kjw mt-12">
      <Content />
    </div>
  </article>
</Base>
